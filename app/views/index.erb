<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Listen to hardcore!</title>
    <meta charset="UTF8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Listen to hardcore and other stuff for free on my site without copyright and other bullshit.">
    <meta name="keywords" content="hardcore, listen online">
    <link rel="shortcut icon" href="favicon.png" type="image/png">
    <link rel="stylesheet" href="stylesheets/style.css" type="text/css">
  </head>
  <body>
    <main>
      <figure class="image-container">
        <img type="image/gif" alt=".gif" id="widget" class="widget">
      </figure>
      <samp id="track-name-output" class="track-name-output">Track name</samp>
      <audio autoplay id="audio-tag" preload="none">Unsupported file format</audio>
      <form class="buttons-container" action="#">
        <select id="playlists" class="playlists">
          <option selected value="hardcore">hardcore</option>
          <option value="crust">crust</option>
          <option value="crossover">crossover</option>
        </select>
        <button type="button" class="buttons" id="prev-track"><</button>
        <button type="button" class="buttons" id="next-track">></button>
      </form>
      <section class="played-tracks-container">
        <h1>Played tracks:</h1>
        <samp  class="played-tracks" id="played-tracks"></samp>
      </section>
      <address>
        <p class="address-text">
          Source: <a href="https://github.com/AxBr94/core-radio" target="_blank">github</a>
          <time>
            <%= @date %>
          </time>
          <a href="#" id="chat-link" class="chat-link">CHAT</a>
        </p>
      </address>
    </main>
    <aside class="chat" id="chat">
      <ol reversed id="message-list" class="message-list">
      </ol>
      <form action="#" id="message-form" class="message-form">
        <input type="text" value="Anon" maxlength="20" name="username" id="user-form-name" class="user-form-name">
        <textarea wrap="hard" placeholder="..." rows="3" maxlength="200" name="message" id="message-form-text" class="message-form-text"></textarea>
        <button type="button" id="send-button" class="send-button">Send</button><button type="reset" class="reset-button">Reset</button>
      </form>
    </aside>
    <script src="javascript/widget.js" type="text/javascript"></script>
    <script src="javascript/script.js" type="text/javascript"></script>
    <script src="javascript/message-controller.js" type="text/javascript"></script>
  </body>
</html>
