<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Listen to hardcore!</title>
    <meta charset="UTF8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="favicon.png" type="image/png">
    <link rel="stylesheet" href="stylesheets/style.css" type="text/css">
  </head>
  <body>
    <main>
      <figure class="image-container">
        <img src="gifs/dude.gif" type="image/gif" alt=".gif" id="vidget" class="vidget">
      </figure>
      <form class="form" action="#">
        <samp id="track-name-output">Track name</samp>
        <audio autoplay src="" id="audio-tag">Unsupported file format</audio>
        <fieldset class="buttons">
          <button type="button" id="prev-track"><</button>
          <button type="button" id="next-track">></button>
        </fieldset>
      </form>
    </main>
    <script src="javascript/script.js" type="text/javascript"></script>
  </body>
</html>
