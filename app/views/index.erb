<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Listen to hardcore!</title>
    <meta charset="UTF8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="favicon.png" type="image/png">
    <link rel="stylesheet" href="stylesheets/style.css" type="text/css">
  </head>
  <body>
    <main>
      <figure class="image-container">
        <img type="image/gif" alt=".gif" id="widget" class="widget">
      </figure>
      <samp id="track-name-output" class="track-name-output">Track name</samp>
      <audio autoplay id="audio-tag">Unsupported file format</audio>
      <form class="buttons-container" action="#">
        <select id="playlists" class="playlists">
          <option selected value="hardcore">hardcore</option>
          <option value="crust">crust</option>
          <option value="crossover">crossover</option>
        </select>
        <button type="button" class="buttons" id="prev-track"><</button>
        <button type="button" class="buttons" id="next-track">></button>
      </form>
      <hr>
      <address>
        <p>
          Source: <a href="https://github.com/AxBr94/core-radio">github</a>
          <time>
            <%= @date %>
          </time>
        </p>
      </address>
    </main>
    <script src="javascript/script.js" type="text/javascript"></script>
    <script src="javascript/widget.js" type="text/javascript"></script>
  </body>
</html>
