<!DOCTYPE html>
<html lang="en">
  <head>
    <title>CHAT</title>
    <meta charset="UTF8">
    <meta name="robots" content="noindex, nofollow">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="favicon.png" type="image/png">
    <link rel="stylesheet" href="stylesheets/chat.css" type="text/css">
  </head>
  <body>
    <ol reversed id="message-list" class="message-list">
    </ol>
    <form action="#" id="form">
      <input type="text" value="Anon" maxlength="20" name="username" id="user-name">
      <textarea rows="10" wrap="hard" placeholder="..." maxlength="200" name="message" id="message-text"></textarea>
      <button type="button" id="send-button">Send</button><button type="reset">Reset</button>
    </form>
    <script src="javascript/message-controller.js" type="text/javascript"></script>
  </body>
</html>